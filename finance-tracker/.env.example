# Copy to .env and fill in. Everything here is optional except for Gmail import.

# Port the app listens on (bound to 127.0.0.1 only, so it is private to your machine)
PORT=4000

# Gmail (read-only) — see README "Connect Gmail". Leave blank to skip Gmail.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI you add in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:4000/api/gmail/callback
